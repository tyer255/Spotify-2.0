# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SPOTIFY_SP_DC: Required to fetch Canvas videos dynamically.
# Since Spotify blocks anonymous traffic from data centers, you must provide your Spotify session cookie.
# How to get it:
# 1. Open an Incognito/Private window and go to open.spotify.com
# 2. Log in to your Spotify account.
# 3. Open Developer Tools (F12) -> Application tab (or Storage tab) -> Cookies -> https://open.spotify.com
# 4. Find the cookie named "sp_dc" and copy its value.
# 5. Add it to your AI Studio Secrets panel as SPOTIFY_SP_DC.
SPOTIFY_SP_DC="YOUR_SP_DC_COOKIE_VALUE_HERE"

# SPOTIFY_CLIENT_ID and SPOTIFY_CLIENT_SECRET: Optional but recommended for dynamic canvas lookup.
# Allows the app to search for Spotify IDs directly via the official API, bypassing web-scraper limits.
# Get them from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID="YOUR_SPOTIFY_CLIENT_ID"
SPOTIFY_CLIENT_SECRET="YOUR_SPOTIFY_CLIENT_SECRET"
